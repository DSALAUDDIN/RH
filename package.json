{
  "name": "rh-dental-care",
  "version": "1.0.0",
  "description": "Website for RH Dental Care, Dhaka (Banani and Banasree branches).",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seo:audit": "node --experimental-strip-types scripts/seo-audit.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.12.5",
    "jose": "^6.2.3",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "nodemailer": "^8.0.5",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5"
  }
}
