# Copy to .env.local and fill in. Never commit real values.

# Database (Prisma). SQLite locally; use a hosted database in production.
DATABASE_URL="file:./dev.db"

# Admin authentication. Required in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# One-time admin bootstrap (unset after the first login).
ADMIN_BOOTSTRAP=
ADMIN_BOOTSTRAP_PASSWORD=

# Enquiry email delivery (Gmail app password or SMTP).
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
CONTACT_TO_EMAIL=

# Persist appointments to the database in addition to email ("true" to enable).
PERSIST_APPOINTMENTS=

# Media uploads (admin video reviews).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Live Google ratings (also requires a placeId per branch in src/lib/branches.ts).
GOOGLE_PLACES_API_KEY=

# Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_ID=

# ==========================================
# RH DENTAL SEO COMMAND CENTER INTEGRATIONS
# ==========================================
# Google Cloud OAuth 2.0 (Search Console, GA4 Data API, Business Profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://rhdentalcare.com/api/admin/seo/auth/google/callback"
# Application-level AES-256-GCM token encryption key (or fallback to JWT_SECRET)
SEO_TOKEN_ENCRYPTION_KEY=

# Property & Location IDs
GSC_SITE_URL="sc-domain:rhdentalcare.com"
GA4_PROPERTY_ID=
GOOGLE_BUSINESS_ACCOUNT_ID=
GBP_BANANI_LOCATION_ID=
GBP_BANASREE_LOCATION_ID=

# Optional: Higher quota for PageSpeed Insights API
PAGESPEED_API_KEY=

# Optional: Secret token for automated cron synchronization (/api/admin/seo/sync)
CRON_SECRET=
