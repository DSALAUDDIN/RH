# Copy to .env.local and fill in. Never commit real values.

# Database (Prisma). SQLite locally; use a hosted database in production.
DATABASE_URL="file:./dev.db"

# Admin authentication. Required in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# One-time admin bootstrap (unset after the first login).
ADMIN_BOOTSTRAP=
ADMIN_BOOTSTRAP_PASSWORD=

# Enquiry email delivery (Gmail app password or SMTP).
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
CONTACT_TO_EMAIL=

# Persist appointments to the database in addition to email ("true" to enable).
PERSIST_APPOINTMENTS=

# Media uploads (admin video reviews).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Live Google ratings (also requires a placeId per branch in src/lib/branches.ts).
GOOGLE_PLACES_API_KEY=

# Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_ID=
